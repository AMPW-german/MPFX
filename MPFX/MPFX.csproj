<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\tooling\msbuild\KsaMod.props" />

	<PropertyGroup>
		<ModName>MPFX</ModName>

		<VersionPrefix>0.3.8</VersionPrefix>
		<AssemblyVersion>0.3.1.0</AssemblyVersion>

		<Company>AMPW</Company>
		<Authors>AMPW</Authors>
		<Copyright>MIT</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ModMenu.Attributes" Version="1.0.2" GeneratePathProperty="true" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PkgModMenu_Attributes)\lib\netstandard2.0\ModMenu.Attributes.dll"
			Link="ModMenu.Attributes.dll" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="KittenExtensions">
			<HintPath>$(KSAModsDir)KittenExtensionsContinued/KittenExtensions.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<StarMapModDependency Include="KittenExtensionsContinued">
			<ImportedAssemblies>KittenExtensions</ImportedAssemblies>
		</StarMapModDependency>
		<StarMapModDependency Include="ShaderExtensions">
			<ImportedAssemblies>ShaderExtensions</ImportedAssemblies>
		</StarMapModDependency>
	</ItemGroup>

	<ItemGroup>
		<None Update="$(ModName)Assests.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<ModManifestArray>assets</ModManifestArray>
		</None>
		<None Update="Shaders\*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Import Project="..\tooling\msbuild\KsaMod.targets" />
</Project>
